# Environment Variables (PRD §38)
# Infrastructure and Secrets Only - All Business Logic is in the Ops Workbook

# Database Connections (Different Roles)
DATABASE_URL=postgres://inventory_app:local_dev_password@localhost:5432/inventory_canonical
MIGRATION_DATABASE_URL=postgres://inventory_app:local_dev_password@localhost:5432/inventory_canonical
ADAPTER_DATABASE_URL=postgres://inventory_app:local_dev_password@localhost:5432/inventory_canonical

# S3-Compatible Object Storage (Local MinIO or Cloud Bucket)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=inventory-documents
STORAGE_ACCESS_KEY=minio_dev_admin
STORAGE_SECRET_KEY=minio_dev_secret_key

# Ultra-Economical AI Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Security & Adapter Secrets
ENGINE_WEBHOOK_SIGNING_SECRET=generate_32_bytes_random_secret_here
ADAPTER_KEY_PEPPER=generate_32_bytes_pepper_here

# Telegram Reference Adapter
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=generate_random_webhook_secret_here
ENGINE_BASE_URL=http://localhost:4000
ENGINE_ADAPTER_KEY=your_adapter_bearer_key_here

# Server Runtime
PORT=4000
LOG_LEVEL=info
